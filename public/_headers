# ============================================================
# Cloudflare Pages — Security Headers & Caching
# ============================================================

# --- Global security headers for all HTML pages ---
# NOTE: script-src 'unsafe-inline' is required — static export emits inline
# scripts (next-themes init + Next.js RSC payloads); no nonce support exists.
# style-src 'unsafe-inline' required for inline style attrs + RainbowKit theme.
# Reown AppKit runtime hosts: api.web3modal.org (remote config, project
# limits, analytics), secure.walletconnect.org (embedded-wallet iframe + SA
# UserOp toolchain), auth.magic.link / api.toaster.magic.link (email OTP),
# pulse.walletconnect.org (telemetry), rpc.walletconnect.org (fallback RPC),
# fonts.reown.com (AppKit UI fonts), cca-lite.coinbase.com (Coinbase Smart
# Wallet SDK analytics). Cloudflare Pages injects its Web Analytics beacon
# from static.cloudflareinsights.com.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.walletconnect.com https://verify.walletconnect.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.reown.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.cinachain.com https://*.basescan.org https://sepolia.base.org https://base-sepolia.publicnode.com https://cloudflare-ipfs.com https://ipfs.io https://*.walletconnect.com https://verify.walletconnect.com https://api.web3modal.org https://secure.walletconnect.org https://auth.magic.link https://api.toaster.magic.link https://pulse.walletconnect.org https://rpc.walletconnect.org https://fonts.reown.com https://cca-lite.coinbase.com https://cinachain-whitelist-api.cinagroup.workers.dev wss://*.walletconnect.com; frame-src 'self' https://verify.walletconnect.org https://*.walletconnect.com https://secure.walletconnect.org https://auth.magic.link; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# --- Static assets: long cache (immutable hashed files) ---
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# --- IPFS NFT images: 30-day cache ---
/ipfs/*
  Cache-Control: public, max-age=2592000, s-maxage=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# --- NFT metadata JSON: short cache 10 min ---
*.json
  Cache-Control: public, max-age=600, s-maxage=300

# --- Service worker: no cache (always up-to-date) ---
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate

# --- HTML pages: short cache + revalidate ---
/*.html
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate
