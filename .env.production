# -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
# Production env vars for CI builds (Next.js loads .env.production in prod mode)
# All values are PUBLIC (contract addresses live on-chain, WC project ID is a
# public client identifier). Server secrets live in Cloudflare secrets, never here.
# -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
NEXT_PUBLIC_CF_IPFS_GATEWAY=https://ipfs.cinachain.com
NEXT_PUBLIC_CF_CDN_GATEWAY=https://cdn.cinachain.com
NEXT_PUBLIC_CF_META_GATEWAY=https://meta.cinachain.com
# 2026-08-22 redeployment (OZ 5.6.0, deployer 0xa1fBED…6060; receipt in the
# deploy-contracts run artifacts). Previous (OZ 5.0.2) contracts, kept for
# reference: NFT 0x9178c3dddfa7287a17b0b33d667236cf7a27bf7c · Badge
# 0x72cc9adb6c877d233e9843ee2d00424b9766d0cf · Credit
# 0x78f5aebc75b7d197b10622cccabe8429617836d7 · Mega
# 0x3443febc3b4e49ea931091aa54871dbcbd972a5f
NEXT_PUBLIC_CINA_NFT_CONTRACT=0xbd0557a0cd7f7250ef39cae58857ccd6d8796490
NEXT_PUBLIC_CINA_ERC1155_CONTRACT=0x0a32fc1302bf7765b386de5eae857c26d6c8e0ce
NEXT_PUBLIC_CINA_CREDIT_CONTRACT=0x03a5637a465707ccd59dce16c1965f4ac84b495a
# CinaMega ERC-1155 mega-collection + exchange (ucina/mcina/cina) — set after deploy-mega.mjs
NEXT_PUBLIC_CINA_MEGA_CONTRACT=0x335e9569520279d9487180ffff803b718e6744bf
# CinaMega media gateway (R2 → 4EVERLAND → on-chain fallback)
NEXT_PUBLIC_MEGA_MEDIA_URL=https://media.cinachain.com
NEXT_PUBLIC_MINT_PRICE_ETH=0.001
NEXT_PUBLIC_WC_PROJECT_ID=c8867b3035029c2152dd54b3c9d0ae80
# Base Sepolia RPC via self-hosted rpc-proxy Worker (proxies Alchemy server-side;
# the Alchemy key is a Worker secret, not a build-time var). See workers/rpc-proxy.
# (base-rpc.cinachain.com is occupied by a legacy Cloudflare Web3 Gateway.)
NEXT_PUBLIC_BASE_RPC=https://rpc-proxy.cinachain.com
NEXT_PUBLIC_SITE_URL=https://nft.cinachain.com

# CinaAuth OIDC SSO - register a Web server application client at
# https://accounts.cinaseek.ai/dashboard/developer
# Client id is injected at build time from the GitHub secret CINAAUTH_CLIENT_ID (leave empty here).
# Client secret only ever reaches the auth-proxy Worker secret, never this file
# Redirect URI (exact match): https://nft.cinachain.com/auth/callback
NEXT_PUBLIC_CINAAUTH_ISSUER=https://auth.cinaseek.ai
NEXT_PUBLIC_CINAAUTH_CLIENT_ID=
# Same-origin proxy for browser OIDC calls (workers/auth-proxy). Empty = <origin>/api/auth
# For local dev with wrangler dev on :8787 use http://localhost:8787/api/auth
NEXT_PUBLIC_CINAAUTH_API_BASE_URL=
NEXT_PUBLIC_USE_PUBLIC_PROVIDER=true
NEXT_PUBLIC_PROD_NETWORKS_DEV=false
NEXT_PUBLIC_APP_ADMINS=0xa1fBED1846E1fA0d7c1D44f60195F2Fc3dC23060
NEXT_PUBLIC_WHITELIST_API_URL=https://whitelist-api.cinachain.com
NEXT_PUBLIC_BILLING_API_URL=https://billing-api.cinachain.com
NEXT_PUBLIC_PAYMASTER_PROXY_URL=/api/paymaster

# Reown AppKit (replaces RainbowKit) — public client id from https://cloud.reown.com
# Reown is WalletConnect — same public project id as NEXT_PUBLIC_WC_PROJECT_ID
NEXT_PUBLIC_REOWN_PROJECT_ID=c8867b3035029c2152dd54b3c9d0ae80
# Pimlico paymaster API key (optional; empty = smart accounts pay their own gas)
NEXT_PUBLIC_PIMLICO_API_KEY=
