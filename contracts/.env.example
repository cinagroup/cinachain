# CinaChain NFT Contract — Environment Variables
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════
# Base Mainnet (primary deployment target)
# ═══════════════════════════════════════════════════
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia (testnet — deploy here first)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Ethereum Mainnet (legacy fallback)
MAINNET_RPC_URL=https://ethereum.publicnode.com

# Your wallet private key (NEVER commit this!)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Owner address (defaults to deployer if not set)
# OWNER=0x9D81DeFB5Bed0D14db479f8E736ACa79A72E8eED

# Basescan API key for contract verification
# Get from https://basescan.org/myapikey
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
