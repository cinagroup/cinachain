# CinaChain NFT Contract — Environment Variables
# Copy to .env and fill in your values

# Sepolia RPC URL (use Alchemy, Infura, or publicnode)
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Mainnet RPC URL (for production deployment)
MAINNET_RPC_URL=https://ethereum.publicnode.com

# Your wallet private key (NEVER commit this!)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Owner address (defaults to deployer if not set)
# Set this if the owner should be different from the deployer
# OWNER=0x9D81DeFB5Bed0D14db479f8E736ACa79A72E8eED

# Etherscan API key for contract verification
# Get from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
